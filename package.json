{
  "name": "dsh-mobile-link",
  "version": "0.1.4",
  "description": "One-click phone access to DeepSeek Harness via a Cloudflare quick tunnel, with the link pushed to your WeChat through your chosen channel (ServerChan / PushPlus / Bark / ntfy / custom webhook).",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-mobile-link": "bin/cli.js"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "cloudflare",
    "cloudflared",
    "tunnel",
    "mobile",
    "wechat",
    "serverchan"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "install.ps1",
    "install.cmd",
    "index.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
